{
  "name": "clop",
  "version": "2.1.0",
  "description": "clop — agentic IDE with your own AI provider (BYOK) and local CLI agents",
  "author": "miks",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.miks.clop",
    "productName": "clop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "e4172383-cyber",
        "repo": "clop"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "clop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
